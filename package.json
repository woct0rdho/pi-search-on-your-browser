{
  "name": "pi-search-on-your-browser",
  "version": "0.8.1",
  "description": "Search Google and read X (Twitter), Reddit, Amazon, and Google Scholar in your own visible Chrome \u2014 same approach as @antirez's ds4-agent. Zero dependencies, no API keys.",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "search",
    "google",
    "chrome",
    "cdp",
    "browser",
    "ds4-agent",
    "twitter",
    "x",
    "amazon",
    "reddit",
    "scholar",
    "subagent",
    "summarization",
    "defuddle",
    "markdown",
    "reader-mode"
  ],
  "author": "xezpeleta",
  "license": "MIT",
  "engines": {
    "node": ">=21.0.0"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}